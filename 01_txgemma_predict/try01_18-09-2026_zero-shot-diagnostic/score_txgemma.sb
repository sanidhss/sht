#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA40x4
#SBATCH --gpus=1 -n 1 -c 8 --mem=64g -t 02:00:00
#SBATCH -J tx_score
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

/work/hdd/bisa/sshah21/envs/txgemma/bin/python /projects/bisa/sshah21/scripts/py_scripts/score_txgemma.py
