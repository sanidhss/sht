module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

# Run prep_orphan_target_data.py first (CPU-only, no GPU needed) and check
# coverage_report.json before submitting this.
/work/hdd/bisa/sshah21/envs/txgemma/bin/python /projects/bisa/sshah21/library/01_txgemma_predict/try05_24-09-2026_lora-smiles-augmentation/lora_finetune_orphan_targets.py
