#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA100x4
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 12:00:00
#SBATCH -J txgemma_lora_cf_attr
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

# TARGETS_TO_RUN scopes both prep and finetune to just cf/attr -- fabry/gaucher's
# already-prepped data and coverage_report.json entries are left untouched. This is
# the fix for try05's scope-creep bug (finetune had no target list of its own).
export TARGETS_TO_RUN=cf,attr

/work/hdd/bisa/sshah21/envs/txgemma/bin/python /projects/bisa/sshah21/library/01_txgemma_predict/try06_29-09-2026_cf-attr-decoupled-scope/prep_orphan_target_data.py
/work/hdd/bisa/sshah21/envs/txgemma/bin/python /projects/bisa/sshah21/library/01_txgemma_predict/try06_29-09-2026_cf-attr-decoupled-scope/lora_finetune_orphan_targets.py
