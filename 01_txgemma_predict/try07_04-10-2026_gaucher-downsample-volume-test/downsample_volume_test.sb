#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA100x4
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 12:00:00
#SBATCH -J gaucher_downsample
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

# No prep step and no TARGETS_TO_RUN here, deliberately. This run reads Gaucher's
# ALREADY-PREPPED train_blind.jsonl and eval_set.json and downsamples them in memory.
# Re-running prep would re-hit ChEMBL/BindingDB/PubChem and could shift the underlying
# data, which would invalidate the comparison against try05's full-size result. Nothing
# in this job writes to gaucher/ -- output goes to gaucher_downsample/.
#
# Budget: 3 seeds x (~35min base-model load + ~85min train on 2,465 lines + ~10min
# validate) is roughly 6.5h. 12h matches try06 and leaves margin; try05 died at an 8h
# budget and 3 model loads is exactly the kind of thing that overruns.

/work/hdd/bisa/sshah21/envs/txgemma/bin/python \
  /projects/bisa/sshah21/library/01_txgemma_predict/try07_04-10-2026_gaucher-downsample-volume-test/downsample_volume_test.py
