#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA100x4
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 06:00:00
#SBATCH -J resolution_probe
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

# Inference only -- no training, no prep, no network. Loads the four already-saved
# adapters and measures how many distinct scores each can emit. Writes to
# resolution_probe/ and touches nothing under the per-target directories.
#
# Budget: 4 adapters x (~35min base-model load + ~310 generations at <2s each) is
# roughly 3h. 6h leaves margin without over-reserving; the dominant cost is the four
# base-model loads, not the generation.
#
# Deliberately a separate load per adapter rather than swapping adapters on one shared
# base -- try06 recorded an unexplained backwards result from the shared-base approach
# that was never root-caused, and this probe's conclusions need to be trustworthy.

/work/hdd/bisa/sshah21/envs/txgemma/bin/python \
  /projects/bisa/sshah21/library/01_txgemma_predict/try08_04-10-2026_output-resolution-probe/output_resolution_probe.py
