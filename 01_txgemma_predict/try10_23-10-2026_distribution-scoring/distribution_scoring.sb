#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA100x4
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 08:00:00
#SBATCH -J dist_scoring
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

export TARGETS=gaucher,attr,cf,fabry
export K_SAMPLES=16
export TEMPERATURE=0.8

# Inference only. No training, no prep, no network. Reuses the four saved adapters and
# try08's exact 200-molecule novel set, changing only how a score is read out of the model.
# Writes to distribution_scoring/ and touches no previous try's outputs.
#
# Budget: 4 adapters x (~35min base-model load + 200 molecules x [1 greedy call + 1 batched
# 16-sample call + 3 forward passes]) is roughly 4-5h. 8h leaves margin. The four base-model
# loads dominate, as in try08.
#
# Separate load per adapter, consistent with try08 and for the same reason: try06 recorded
# an unexplained backwards result from sharing one base across adapters that was never
# root-caused.

/work/hdd/bisa/sshah21/envs/txgemma/bin/python \
  /projects/bisa/sshah21/library/01_txgemma_predict/try10_23-10-2026_distribution-scoring/distribution_scoring.py
