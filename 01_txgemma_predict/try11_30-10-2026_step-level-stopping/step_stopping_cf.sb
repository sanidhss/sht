#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA100x4
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 10:00:00
#SBATCH -J stepstop_cf
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

# One target per job, TARGET explicit -- the try05 scope-coupling bug cannot recur.
export TARGET=cf
export SEEDS=0,1,2
export N_EPOCH=2
export LR=6.666666666666667e-05   # 1/3 of try09's 2e-4
export EVALS_PER_EPOCH=7
export VAL_EVAL_CAP=400
export N_DECOYS=500

# 6050_train_lines_-_largest_target
# Each seed: ~35min base-model load + training + ~14 step-level validations + scoring 505
# molecules (reference, 3 held-out hard negatives, 500 decoys) with BOTH readouts from one
# forward pass each.

/work/hdd/bisa/sshah21/envs/txgemma/bin/python \
  /projects/bisa/sshah21/library/01_txgemma_predict/try11_30-10-2026_step-level-stopping/step_stopping_eval.py
