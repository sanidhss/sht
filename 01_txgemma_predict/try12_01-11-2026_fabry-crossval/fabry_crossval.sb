#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA100x4
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 10:00:00
#SBATCH -J fabry_crossval
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

export K_FOLDS=6
export SEEDS=0,1,2
export N_EPOCH=2
export LR=6.666666666666667e-05   # identical to try11 -- only the validation scheme changes
export EVALS_PER_EPOCH=7
export N_DECOYS=500

# Budget: 6 CV folds (curve only, no scoring) + 3 final runs (train + score 504 molecules).
# Fabry trains in ~2min per run, so the ~35min base-model load dominates:
#   phase 1: 6 x (35 load + ~3 train/eval)        ~= 3.8h
#   phase 2: 3 x (35 load + ~2 train + ~10 score) ~= 2.4h
# ~6.2h total; 10h leaves margin.

/work/hdd/bisa/sshah21/envs/txgemma/bin/python \
  /projects/bisa/sshah21/library/01_txgemma_predict/try12_01-11-2026_fabry-crossval/fabry_crossval.py
