#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA100x4
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 08:00:00
#SBATCH -J try14_B_small
#SBATCH -a 0-0
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%A_%a.out

# JOB B (GPU array), the expected-crossval target: tyrosinemia (~100 compounds).
# Same dispatcher as the large array -- it reads routing.json and runs whichever harness
# job A chose, so if tyrosinemia unexpectedly routes to stepstop it still runs correctly;
# 8h is ample for ~100 compounds either way.
#
# 8h: the crossval path loads the base model 9 times (6 folds + 3 seeds) and the measured
# load is ~25 min, so ~3.75h is pure model loading before any training happens -- the load
# genuinely dominates a short run, exactly as the plan assumed. HPD prompts are 433 tokens
# and ~100 compounds give ~500 lines, so the training itself is minor.

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

NAMES=(tyrosinemia)
export TARGET=${NAMES[$SLURM_ARRAY_TASK_ID]}

# try11's parameters, unchanged and set explicitly so the log records them.
export SEEDS=0,1,2
export N_EPOCH=2
export LR=6.666666666666667e-05
export EVALS_PER_EPOCH=7
export VAL_EVAL_CAP=400
export N_DECOYS=500

bash /projects/bisa/sshah21/library/01_txgemma_predict/try14_10-11-2026_new-target-set/run_routed.sh
