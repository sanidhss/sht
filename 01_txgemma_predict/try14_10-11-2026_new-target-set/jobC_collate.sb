#!/bin/bash
#SBATCH -A bisa-delta-cpu
#SBATCH -p cpu
#SBATCH -n 1 -c 4 --mem=16g -t 00:30:00
#SBATCH -J try14_C_collate
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%j.out

# JOB C (CPU): collate everything into results.csv + SUMMARY.md.
# Depends on BOTH B arrays with afterany, so it still runs -- and still reports -- if a
# task failed or timed out. It names what is missing instead of producing nothing.

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma

python /projects/bisa/sshah21/library/01_txgemma_predict/try14_10-11-2026_new-target-set/collate_results.py
