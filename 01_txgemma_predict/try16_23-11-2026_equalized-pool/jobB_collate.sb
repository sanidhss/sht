#!/bin/bash
#SBATCH -A bisa-delta-cpu
#SBATCH -p cpu
#SBATCH -n 1 -c 4 --mem=16g -t 00:30:00
#SBATCH -J try16_B_collate
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma

# afterany, not afterok: if one array task dies this must still produce a usable report
# that names what is missing, rather than producing nothing.
/work/hdd/bisa/sshah21/envs/txgemma/bin/python \
  /projects/bisa/sshah21/library/01_txgemma_predict/try16_23-11-2026_equalized-pool/collate_pool.py
