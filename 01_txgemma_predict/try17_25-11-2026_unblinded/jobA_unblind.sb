#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA100x4
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 16:00:00
#SBATCH -J try17_A_unblind
#SBATCH -a 0-5
#SBATCH -o /work/hdd/bisa/sshah21/results/txgemma_lora_orphan/%x_%A_%a.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

# RETRAINS each target with the reference drug's own measured label in the training
# pool, then scores the frozen equalized pool. This is a new fine-tune, not inference:
# try16's adapters were trained blind and there is no way to unblind them after the
# fact.
#
# Six tasks, not eight. gaucher's ambroxol and gnsiad's tolvaptan are absent from
# pool_v1 by canonical structure, so an unblinded adapter for them could not be ranked
# on the shared pool and the script exits 0 with a NOT_EVALUABLE marker rather than
# burning ~10h to train something unscoreable. That limitation is about the pool, not
# about blinding.
#
# Every try11 hyperparameter is held fixed so the reference's presence in training is
# the only variable between this and try14/try11:
export SEEDS=0,1,2
export N_EPOCH=2
export LR=6.666666666666667e-05
export EVALS_PER_EPOCH=7
export VAL_EVAL_CAP=400
export UNBLIND=1

NAMES=(cf fabry attr cel mastocytosis tyrosinemia)
export TARGET=${NAMES[$SLURM_ARRAY_TASK_ID]}

# Budget: try14 measured 5h35m-8h00m to train 3 seeds per target. Pool scoring adds
# 3 x 1933 generations at ~0.64s = ~1h02m (try16 measured exactly that). ~9h expected,
# 16h reserved -- fabry and tyrosinemia are small and will finish early, and losing a
# 9h training run at the 8h mark would be the expensive mistake.
echo "=== try17 task $SLURM_ARRAY_TASK_ID -> TARGET=$TARGET UNBLIND=$UNBLIND ==="
/work/hdd/bisa/sshah21/envs/txgemma/bin/python \
  /projects/bisa/sshah21/library/01_txgemma_predict/try17_25-11-2026_unblinded/unblinded_pool_eval.py
