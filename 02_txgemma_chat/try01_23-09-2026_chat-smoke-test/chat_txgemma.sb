#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA40x4
#SBATCH --gpus=2 -n 1 -c 16 --mem=96g -t 00:30:00
#SBATCH -J tx_chat
#SBATCH -o %x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

/work/hdd/bisa/sshah21/envs/txgemma/bin/python /projects/bisa/sshah21/scripts/py_scripts/chat_txgemma.py
