#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA40x4
#SBATCH --gpus=2 -n 1 -c 16 --mem=96g -t 00:20:00
#SBATCH -J tx_chaperone
#SBATCH -o /work/hdd/bisa/sshah21/results/blind_chaperone_rank/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

/work/hdd/bisa/sshah21/envs/txgemma/bin/python /projects/bisa/sshah21/scripts/py_scripts/blind_chaperone_rank_txgemma.py
