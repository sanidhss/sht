#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA40x4
#SBATCH --gpus=4 -n 1 -c 16 --mem=128g -t 01:30:00
#SBATCH -J screen_cold
#SBATCH -o /work/hdd/bisa/sshah21/results/reasoning_screen/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

TRY=/projects/bisa/sshah21/library/02_txgemma_chat/try09_18-10-2026_cold-condition-endtoend
PY=/work/hdd/bisa/sshah21/envs/txgemma/bin/python
COND=/work/hdd/bisa/sshah21/results/reasoning_screen/cold_condition_fabry.json

# Batch 12 rather than try08's 16: that run hit a CUDA OOM warning mid-screen and only
# completed because the caching allocator retried.
echo "########## SMOKE TEST (64 candidates, cold condition) ##########"
$PY $TRY/screen_cold_condition.py --target fabry --condition-file $COND --limit 64 --batch-size 12 || exit 1

echo
echo "########## FULL LIBRARY (cold condition) ##########"
$PY $TRY/screen_cold_condition.py --target fabry --condition-file $COND --batch-size 12
