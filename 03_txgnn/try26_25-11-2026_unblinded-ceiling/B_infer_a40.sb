#!/bin/bash
#SBATCH -A bisa-delta-gpu
#SBATCH -p gpuA40x4-preempt
#SBATCH --gpus=1 -n 1 -c 16 --mem=128g -t 06:00:00
#SBATCH -J txgnn_t26_Ba40
#SBATCH --array=0-9
#SBATCH --requeue
#SBATCH -o /work/hdd/bisa/sshah21/results/txgnn/%x_%A_%a.out
# Preemptible duplicate of B_infer.sb, submitted because gpuA100x4 is congested. Safe to
# run alongside the A100 copy: unblind_infer.py skips any seed whose targets.pkl already
# exists and writes new ones atomically, so the two copies divide the work and neither can
# corrupt the other's output. --requeue means a preemption just restarts the task, which
# then skips the seeds already finished. A40 is ~2x slower than A100 (try24), but this is
# inference only -- one forward pass per seed -- so 6h is ample either way.
cd /projects/bisa/sshah21/library/03_txgnn/try26_25-11-2026_unblinded-ceiling
/work/hdd/bisa/sshah21/envs/txgnn2/bin/python -u unblind_infer.py
