#!/bin/bash
#SBATCH -A bisa-delta-cpu
#SBATCH -p cpu
#SBATCH -n 1 -c 8 --mem=32g -t 08:00:00
#SBATCH -J hf_download
#SBATCH -o /work/hdd/bisa/sshah21/hf_cache/logs/%x_%j.out

module load miniforge3-python
source activate /work/hdd/bisa/sshah21/envs/txgemma
export HF_HOME=/work/hdd/bisa/sshah21/hf_cache

hf download google/txgemma-9b-predict
hf download google/txgemma-27b-predict
hf download google/txgemma-27b-chat
